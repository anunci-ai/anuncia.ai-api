# =========================
# Servidor
# =========================
NODE_ENV=development
PORT=8080
# URL pública desta API (usada pela QStash para callbacks de webhook)
API_URL=http://localhost:8080

# =========================
# Banco de dados (PostgreSQL)
# =========================
# Conexão local via docker-compose (veja docker-compose.yml)
DATABASE_URL=postgresql://docker:docker@localhost:5432/anunciadb

# =========================
# Autenticação JWT
# =========================
JWT_SECRET=
JWT_EXPIRES_IN=7d

# =========================
# Google OAuth
# =========================
# Obtido em https://console.cloud.google.com/ (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=

# =========================
# Cloudflare R2 (S3-compatible storage)
# =========================
# Obtido em https://dash.cloudflare.com/ > R2
CLOUDFLARE_ENDPOINT=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# =========================
# Upstash QStash (fila de jobs assíncronos)
# =========================
# Obtido em https://console.upstash.com/qstash
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# =========================
# Serviços de IA
# =========================
# Google Gemini (geração de texto) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
AI_TEXT_MODEL=gemini-2.0-flash

# fal.ai (geração de imagens) — https://fal.ai/dashboard/keys
FAL_KEY=
